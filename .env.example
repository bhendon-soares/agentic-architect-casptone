AAMAD_TARGET_RUNTIME=
APP_ENV=
POSTGRES_PASSWORD=
DATABASE_URL=
KNOWLEDGE_BASE_PATH=
# Apenas para desenvolvimento local/testes. Para validar o MVP na PDI, use servicenow no .env local.
TICKET_ADAPTER_MODE=mock
# CrewAI OpenAI: use o identificador do modelo com prefixo openai/.
# Trocar LLM_MODEL NAO ativa custo: a telemetria e as tarifas ainda precisam ser adaptadas
# para OpenAI antes de exibir estimativas na aba IA.
LLM_PROVIDER=
LLM_MODEL=
# Preencha somente no .env local; nunca inclua a chave neste template.
OPENAI_API_KEY=
# Configuracao Azure anterior (somente se voltar a usar o provider Azure):
# AZURE_API_KEY=
# AZURE_ENDPOINT=
# AZURE_API_VERSION=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_MAX_RPM=
# Opcional: JSON de precos de referencia (somente exibicao; todas as entradas devem ter active=false).
# Ex.: src/backend/config/pricing-reference.example.json. Referencias nunca entram no calculo de custo.
PRICING_REFERENCE_PATH=
# Usadas pelo adapter real quando TICKET_ADAPTER_MODE=servicenow; preencha somente no .env local.
SERVICENOW_BASE_URL=
SERVICENOW_INCIDENT_TABLE_PATH=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_AUTH_MODE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
LOG_LEVEL=
# Envia traces (prompts/respostas) ao CrewAI AMP; requer `crewai login`. Use apenas com dados ficticios.
CREWAI_TRACING_ENABLED=