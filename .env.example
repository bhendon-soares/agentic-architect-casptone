AAMAD_TARGET_RUNTIME=
APP_ENV=
POSTGRES_PASSWORD=
DATABASE_URL=
KNOWLEDGE_BASE_PATH=
# Apenas para desenvolvimento local/testes. Para validar o MVP na PDI, use servicenow no .env local.
TICKET_ADAPTER_MODE=mock
# CrewAI Azure: use o nome do deployment no Foundry (ex.: azure/gpt-6-sol).
LLM_PROVIDER=
LLM_MODEL=
# No .env local, use a chave do recurso; nunca a inclua neste template.
AZURE_API_KEY=
# Endpoint do recurso Azure OpenAI (nao a URL do portal Foundry nem a URL completa de chat/completions).
# Se o deployment usar um endpoint Foundry de inferencia, use a URL de inferencia fornecida pelo recurso.
AZURE_ENDPOINT=
# Confirme no deployment a versao de API suportada.
AZURE_API_VERSION=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_MAX_RPM=
# Usadas pelo adapter real quando TICKET_ADAPTER_MODE=servicenow; preencha somente no .env local.
SERVICENOW_BASE_URL=
SERVICENOW_INCIDENT_TABLE_PATH=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_AUTH_MODE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
LOG_LEVEL=